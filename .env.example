NEXT_PUBLIC_SITE_URL=https://deltalabs.tech

# --- Database (server-only; never prefix with NEXT_PUBLIC_) ------------------
# Stores internship applications, CVs (GridFS), admin users and sessions.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=deltalabs

# --- Security ------------------------------------------------------------------
# Long random string (e.g. `openssl rand -hex 32`). Salts hashed IPs used for rate limiting.
SESSION_SECRET=change-me
# Bearer token for the daily data-retention job (/api/cron/retention).
CRON_SECRET=change-me
# Only if behind Cloudflare: trust its client-IP header for rate limiting.
# CLIENT_IP_HEADER=cf-connecting-ip

# --- Data retention (months) ------------------------------------------------------
APPLICATION_RETENTION_MONTHS=12
TALENT_POOL_RETENTION_MONTHS=24

# --- Email via Resend (optional; skipped when unset) ---------------------------
# Applicant acknowledgement + internal alert. The from-address domain must be verified in Resend.
RESEND_API_KEY=
RECRUITMENT_FROM_EMAIL=Delta Labs Careers <careers@deltalabs.tech>
RECRUITMENT_NOTIFY_EMAIL=subhan@deltalabs.tech

# --- Analytics (public) -------------------------------------------------------------
# GA4 measurement ID; GA4 is disabled when unset. The Meta Pixel ID lives in
# app/components/meta-pixel-snippet.ts.
NEXT_PUBLIC_GA4_ID=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only MongoDB settings. Never expose these with a NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agency_unlock?retryWrites=true&w=majority
MONGODB_DATABASE=agency_unlock

# Email notification on new application (via Resend, resend.com).
# Without a verified sending domain, Resend only allows delivery to the
# email address of the Resend account itself — so NOTIFY_EMAIL must match
# the address you signed up to Resend with.
RESEND_API_KEY=re_your_api_key
NOTIFY_EMAIL=you@example.com
# NOTIFY_FROM_EMAIL=Agency Unlock <onboarding@resend.dev>
